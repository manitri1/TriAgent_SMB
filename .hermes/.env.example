# $HERMES_HOME/.env — Hermes Agent CLI가 컨테이너 기동 시 직접 읽는 파일입니다.
# 사용법: 이 파일을 같은 폴더에 `.env`로 복사한 뒤 실제 키를 채우세요.
#   cp .hermes/.env.example .hermes/.env
# `.hermes/.env`는 커밋하지 마세요 (.gitignore에 이미 등록됨).
# top-level .env는 프로필에 상속되지 않습니다 — 7개 profiles/<role>/.env에도 동일 키를
# 복사해야 합니다 (README.md 배포 스크립트 참고).

# .hermes/config.yaml 및 profiles/<role>/config.yaml의 provider: openai-api 에 필요합니다.
OPENAI_API_KEY=sk-...

# ── Discord ───────────────────────────────────────────────────────────
# 필수: 봇 토큰. 없으면 게이트웨이가 Discord 어댑터를 시작하지 않습니다.
# Discord Developer Portal → Bot → Reset Token으로 발급받은 값을 채우세요.
DISCORD_BOT_TOKEN=

# 접근 제어 — 둘 중 최소 하나, 또는 DISCORD_ALLOW_ALL_USERS=true 필요
# (없으면 0.18+ 정책상 모든 사용자를 기본 거부합니다).
DISCORD_ALLOWED_USERS=
# DISCORD_ALLOWED_ROLES=

# 운영 알림(HITL 승인 요청, 노쇼 리마인더 등)을 coordinator가 먼저 보낼 홈 채널.
# `/sethome` 슬래시 커맨드로도 설정 가능합니다 (docs/15-discord-integration.md 참고).
# DISCORD_HOME_CHANNEL=
# DISCORD_HOME_CHANNEL_NAME="#smb-ops"

# Mock POS(docs/05-skills-and-tools.md) 접속 정보 — order-payment-agent, inventory-agent,
# reservation-agent, sales-analytics-agent의 code_execution Skill이 사용합니다.
MOCK_POS_BASE_URL=http://mock-pos:8080
MOCK_POS_API_KEY=dev-key
STORE_ID=store_demo
