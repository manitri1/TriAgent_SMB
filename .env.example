# docker-compose.yml이 읽는 환경변수. 실제 값은 `.env`(gitignore됨)에 채운다.

# webapp(마니카페 운영 콘솔) 자체 Basic Auth 비밀번호 해시.
# 생성: cd webapp && python scripts/hash_password.py '원하는비밀번호'
# 주의: 해시 형식(scrypt$16384$8$1$salt$hash)에 '$'가 들어있다. docker compose는
# .env 값 안의 '$'도 변수 치환 문법으로 해석하므로, 여기 넣을 때는 '$'를 '$$'로
# 전부 이스케이프해야 한다(안 그러면 "variable is not set" 경고와 함께 해시가
# 잘려서 로그인이 항상 실패한다).
WEBAPP_BASIC_AUTH_PASSWORD_HASH=

# 선택 — 기본값은 docker-compose.yml에 이미 지정되어 있음
# WEBAPP_BASIC_AUTH_USERNAME=admin
# MOCK_POS_API_KEY=dev-key
# STORE_ID=store_demo
# HERMES_EXEC_TIMEOUT_SECONDS=500
