# 저장소 루트 .env — docker-compose가 변수 치환(${VAR:-default})을 위해 자동으로 읽는 파일.
# 사용법: cp .env.example .env 후 실제 운영 값으로 교체하세요. `.env`는 커밋하지 않습니다
# (.gitignore에 이미 등록됨).
#
# 이 파일이 없어도 docker-compose.yml의 기본값(dev-key, owner/smb-dashboard-dev-2026 등)으로
# 그대로 기동됩니다 — 로컬 개발용 기본값이며, 실제 운영 전에는 반드시 교체하세요
# (docs/13-mvp-dashboard-design.md §6).

# smb-dashboard basic-auth 자격증명
DASHBOARD_BASIC_AUTH_USER=owner
DASHBOARD_BASIC_AUTH_PASSWORD=smb-dashboard-dev-2026

# 저재고 경고 임계치 (전역 상수, docs/13 §8: 품목별 임계치는 MVP 범위 밖)
LOW_STOCK_THRESHOLD=10

# Mock POS 접속 정보 (.hermes/.env.example과 동일 값 — docker-compose 변수 치환용)
MOCK_POS_API_KEY=dev-key
STORE_ID=store_demo
